local function findGunDrop()
    if not watchingDrops then
        watchingDrops = true
        local function remember(part)
            if part.Name == "GunDrop" and part:IsA("BasePart") then gunDrops[part] = true end
        end
        bind(workspace.DescendantAdded, remember)
        for _, part in ipairs(workspace:GetDescendants()) do remember(part) end
    end
    for part in pairs(gunDrops) do
        if part.Parent and part.Name == "GunDrop" and part:IsDescendantOf(workspace) then return part end
        gunDrops[part] = nil
    end
    return nil
end

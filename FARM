local function postWebhook(payload)
    if not httpRequest then return false, "executor has no request()" end
    local body = HttpService:JSONEncode(payload)
    local urls = {cfg.webhookUrl}
    -- запасной вариант, если executor не может достучаться до discord.com напрямую
    urls[2] = cfg.webhookUrl:gsub("^https://[%w%.]*discord%.com", "https://webhook.lewisakura.moe")
    local lastErr = "no response"
    for _, url in ipairs(urls) do
        local ok, res = pcall(httpRequest, {
            Url = url, Method = "POST",
            Headers = {["Content-Type"] = "application/json"}, Body = body,
        })
        if not ok then
            lastErr = tostring(res)
        elseif type(res) ~= "table" then
            lastErr = "bad response: " .. type(res)
        else
            local code = tonumber(res.StatusCode or res.status_code or res.Status or res.status) or 0
            if (code >= 200 and code < 300) or (code == 0 and res.Success == true) then
                return true, code
            end
            local msg = tostring(res.StatusMessage or res.Body or "")
            lastErr = "HTTP " .. code .. (msg ~= "" and (" " .. msg:sub(1, 80)) or "")
        end
    end
    return false, lastErr
end

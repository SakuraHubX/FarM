local potatoDone = setmetatable({}, {__mode = "k"})
local potatoConn, potatoQueue = nil, {}
local function potatoObj(o)
    if potatoDone[o] then return end
    potatoDone[o] = true
    if o:IsA("BasePart") then
        o.Material = Enum.Material.SmoothPlastic
        o.Reflectance = 0
        o.CastShadow = false
        if o:IsA("MeshPart") then
            o.TextureID = ""
            o.RenderFidelity = Enum.RenderFidelity.Performance
        end
    elseif o:IsA("SpecialMesh") then
        o.TextureId = ""
    elseif o:IsA("Decal") or o:IsA("Texture") then
        o.Transparency = 1
    elseif o:IsA("SurfaceAppearance") or o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
        o:Destroy()
    elseif o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") or o:IsA("Explosion") then
        o.Enabled = false
    elseif o:IsA("PostEffect") then
        o.Enabled = false
    elseif o:IsA("Atmosphere") then
        o.Density = 0
        o.Haze = 0
    end
end
local potatoRunId = 0
local function applyPotato(on)
    potatoRunId += 1
    local myRun = potatoRunId
    if potatoConn then
        potatoConn:Disconnect()
        potatoConn = nil
    end
    table.clear(potatoQueue)
    if not on then return end
    local Lighting = game:GetService("Lighting")
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)
    pcall(sethiddenproperty, Lighting, "Technology", Enum.Technology.Compatibility)
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function() if setfpscap then setfpscap(0) end end)
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        pcall(function()
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end)
        pcall(sethiddenproperty, terrain, "Decoration", false)
    end
    potatoConn = workspace.DescendantAdded:Connect(function(o) potatoQueue[#potatoQueue + 1] = o end)
    task.spawn(function()
        local n = 0
        for _, root in ipairs({Lighting, workspace}) do
            for _, o in ipairs(root:GetDescendants()) do
                if myRun ~= potatoRunId or not alive then return end
                pcall(potatoObj, o)
                n += 1
                if n % 250 == 0 then task.wait() end
            end
        end
        while alive and myRun == potatoRunId do
            for _ = 1, math.min(#potatoQueue, 120) do
                local o = table.remove(potatoQueue)
                if o and o.Parent then pcall(potatoObj, o) end
            end
            task.wait(0.15)
        end
    end)
end


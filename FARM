local roleState = {roles = {}, refreshing = false, last = 0}
local function loadRoleModule(mod)
    if not (mod and mod:IsA("ModuleScript")) then return nil end
    local ok, src = pcall(require, mod)
    if ok and type(src) == "table" and type(src.GetLatestPlayerData) == "function" then return src end
end
local function roleSource()
    if roleState.source then return roleState.source end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local client = modules and modules:FindFirstChild("Client")
    roleState.source = loadRoleModule(modules and modules:FindFirstChild("CurrentRoundClient"))
        or loadRoleModule(ReplicatedStorage:FindFirstChild("CurrentRoundClient"))
        or loadRoleModule(client and client:FindFirstChild("CurrentRoundClient"))
        or loadRoleModule(ReplicatedStorage:FindFirstChild("Client") and ReplicatedStorage.Client:FindFirstChild("CurrentRoundClient"))
    return roleState.source
end
local function inferRole(player)
    local ch = player.Character
    if not ch then return nil end
    for _, tool in ipairs(ch:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if n:find("knife", 1, true) then return "Murderer" end
            if n:find("gun", 1, true) then return "Sheriff" end
        end
    end
end
local function refreshRoleData()
    local src = roleSource()
    if src then
        local ok, roles = pcall(function() return src.GetLatestPlayerData() end)
        if ok and type(roles) == "table" then roleState.roles = roles end
        return
    end
    local roles = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local role = inferRole(p)
        if role then
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            roles[p.Name] = {Role = role, Dead = hum ~= nil and hum.Health <= 0, Killed = false}
        end
    end
    roleState.roles = roles
end
local function getRoles()
    if not roleState.refreshing and os.clock() - roleState.last >= 0.25 then
        roleState.refreshing = true
        task.spawn(function()
            pcall(refreshRoleData)
            roleState.last = os.clock()
            roleState.refreshing = false
        end)
    end
    return roleState.roles
end

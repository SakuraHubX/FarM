minB.MouseButton1Click:Connect(function()
    main.Visible = false
    pill.Visible = true
end)
closeB.MouseButton1Click:Connect(function()
    main.Visible = false
    pill.Visible = false
end)
bind(UIS.InputBegan, function(i, gp)
    if not gp and i.KeyCode == Enum.KeyCode.G then
        pill.Visible = false
        main.Visible = not main.Visible
    end
end)

-- UI refresh (1 Hz when hidden is skipped)
task.spawn(function()
    while alive do
        local el = os.clock() - session.start
        local visible = main.Visible
        if rejoinReady() then
            subtitle.Text = "v4 · auto farm · full stats · auto rejoin ready"
            subtitle.TextColor3 = C.sub
        else
            subtitle.Text = "! paste Script URL in Safety for auto-restart"
            subtitle.TextColor3 = RED
        end
        if cfg.whiteScreen then whiteInfo.Text = "FlinFarm  ·  " .. status .. "\n" .. fmt(session.coins) .. " collected  ·  " .. fmt(session.rate) .. "/h" end
        if pill.Visible then pillSub.Text = fmt(session.coins) .. " · " .. status end
        if visible then
            live.coins.Text = fmt(session.coins)
            live.rate.Text = fmt(session.rate)
            live.total.Text = fmt(totals.coins)
            live.status.Text = status
            live.status.TextColor3 = statusColor
            live.status.TextSize = #status > 12 and 18 or 26
            if pages.Stats.Visible then
                rows.uptime.Text = fmtTime(el)
                rows.coins.Text = fmt(session.coins)
                local parts = {}
                for name, v in pairs(session.bags) do parts[#parts + 1] = name .. " " .. fmt(v) end
                rows.bags.Text = #parts > 0 and table.concat(parts, " · ") or "-"
                rows.rate.Text = fmt(session.rate) .. "/h"
                rows.day.Text = fmt(session.rate * 24)
                rows.best.Text = fmt(totals.bestRate) .. "/h"
                rows.rounds.Text = tostring(session.rounds or 0)
                rows.avg.Text = (session.rounds or 0) > 0 and fmt(session.coins / session.rounds) or "-"
                rows.total.Text = fmt(totals.coins)
                rows.alltime.Text = fmtTime(totals.seconds)
                rows.sessions.Text = tostring(totals.sessions)
                rows.kicks.Text = tostring(totals.kicks)
                rows.rejoins.Text = tostring(totals.rejoins)
                rows.bagdbg.Text = (bagFull() and "FULL" or "not full") .. " (cap " .. cfg.bagCap .. ")"
                rows.murd.Text = murdererPlayer and murdererPlayer.Name or "unknown"
                rows.reason.Text = totals.lastReason
                rows.ping.Text = string.format("%d ms", ping)
                rows.fps.Text = string.format("%d", fps)
            end
        end
        task.wait(1)
    end
end)

-- cleanup + autostart
getgenv().FlinFarmCleanup = function()
    alive = false
    cfg.farm = false
    pcall(function() RunService:Set3dRenderingEnabled(true) end)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
    pcall(function() pillGui:Destroy() end)
    pcall(function() whiteGui:Destroy() end)
    potatoRunId += 1
end
applyRender()
applyWhite()
if cfg.potato then applyPotato(true) end
if cfg.autoStart and wasFarming then
    task.delay(2, function()
        cfg.farm = true
        for _, r in ipairs(setters) do pcall(r) end
    end)
end

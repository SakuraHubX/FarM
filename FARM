-- pill
local pillGui = New("ScreenGui", {Name = "FlinFarmPill", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1000}, gethui and gethui() or CoreGui)
local pill = New("TextButton", {
    Text = "", AutoButtonColor = false, Visible = false, BackgroundColor3 = C.bg,
    Size = UDim2.fromOffset(190, 44), Position = UDim2.new(0.5, -95, 0, 14),
}, pillGui)
round(pill, 22)
outline(pill, 2)
local pav = New("ImageLabel", {Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(6, 5), BackgroundTransparency = 1, Image = logo}, pill)
round(pav, 17)
text(pill, "FlinFarm", 19, C.text, UDim2.fromOffset(48, 0), UDim2.new(1, -56, 0.55, 0))
local pillSub = text(pill, "", 13, C.sub, UDim2.fromOffset(48, 22), UDim2.new(1, -56, 0, 18))
do
    local dragging, moved, start, startPos
    bind(pill.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, moved, start, startPos = true, false, i.Position, pill.Position
        end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - start
            if d.Magnitude > 5 then moved = true end
            if moved then pill.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end
        end
    end)
    bind(UIS.InputEnded, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            if not moved then
                pill.Visible = false
                main.Visible = true
            end
        end
    end)
end
minB.MouseButton1Click:Connect(function()
    main.Visible = false
    pill.Visible = true
end)
closeB.MouseButton1Click:Connect(function()
    main.Visible = false
    pill.Visible = false
end)
bind(UIS.InputBegan, function(i, gp)

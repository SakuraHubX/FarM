local shotDbg = {text = "no shots yet", n = 0}
local aimCycle = 0
function FarmRuntime.shoot(context, motion, target)
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not target or not ch or not hum or hum.Health <= 0 then shotDbg.text = "no target / dead"; return false end
    local gun = ch:FindFirstChild("Gun")
    if not gun then
        local bp = LP:FindFirstChild("Backpack")
        local tool = bp and bp:FindFirstChild("Gun")
        if not tool then shotDbg.text = "no gun"; return false end
        pcall(function() hum:EquipTool(tool) end)
        shotDbg.text = "equipping gun"
        return false
    end
    local shoot = gun:FindFirstChild("Shoot")
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    local root = ch:FindFirstChild("HumanoidRootPart")
    if not shoot or not tRoot or not root then shotDbg.text = "gun has no Shoot remote"; return false end
    local nowT = os.clock()
    if nowT - (shotDbg.t or 0) < 0.3 then return false end
    shotDbg.t = nowT
    local gyro = root:FindFirstChild("PulseFarmBG")
    if gyro then pcall(function() gyro:Destroy() end) end
    local muzzle = ch:FindFirstChild("GunRaycastAttachment", true)
    local head = ch:FindFirstChild("Head")
    local origin = muzzle and muzzle.WorldPosition or (head and head.Position) or root.Position
    local dist = (tRoot.Position - origin).Magnitude
    local vel = tRoot.AssemblyLinearVelocity
    if vel.Magnitude > 120 then vel = Vector3.zero end
    -- ping ~ ms, + travel time; ping может быть в мс
    local p = (ping or 0)
    if p > 5 then p = p / 1000 end
    local lead = math.clamp(p + dist / 300 + 0.04, 0.05, 0.45)
    aimCycle = (aimCycle % 3) + 1
    local yOff = ({0, 1.2, -0.8})[aimCycle]
    local aimPos = tRoot.Position + Vector3.new(vel.X * lead, yOff, vel.Z * lead)
    if (aimPos - origin).Magnitude < 0.3 then shotDbg.text = "too close"; return false end
    local sent = pcall(function() shoot:FireServer(CFrame.new(origin, aimPos), CFrame.new(aimPos)) end)
    shotDbg.n += 1
    shotDbg.text = string.format("shot #%d  dist %.0f  %s", shotDbg.n, dist, sent and "sent" or "error")
    shotDbg.last = nowT
    return sent
end

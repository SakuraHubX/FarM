local function fmt(n)
    n = n or 0
    if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if n >= 1e4 then return string.format("%.1fk", n / 1e3) end
    return tostring(math.floor(n))
end
local function fmtTime(s)
    s = math.floor(s)
    return string.format("%02d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end

-- ───────── helpers: game state ─────────
local function chain(root, ...)
    local cur = root
    for _, name in ipairs({...}) do
        if not cur then return nil end
        cur = cur:FindFirstChild(name)
    end
    return cur
end
local function getChar()
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if ch and hum and hrp and hum.Health > 0 then return ch, hum, hrp end
end
local bagCache, bagCacheAt = false, 0
local function bagFull()
    if os.clock() - bagCacheAt < 0.25 then return bagCache end
    bagCacheAt = os.clock()
    local full = false
    local pg = LP:FindFirstChild("PlayerGui")
    local n = chain(pg, "MainGUI", "Lobby", "Dock", "CoinBags", "FullBagNotification")
    if n and n.Visible then full = true end
    -- counter check: any bag counter reached the bag size
    if not full then
        local box = chain(pg, "MainGUI", "Game", "CoinBags", "Container")
        if box then
            for _, bag in ipairs(box:GetChildren()) do
                local label = bag:FindFirstChild("Coins", true)
                if label and label:IsA("TextLabel") then
                    local v = tonumber((label.Text:gsub("[^%d]", ""))) or 0
                    if v >= cfg.bagCap then full = true break end
                end
            end
        end
    end
    -- text check: any visible "Full" / "Заполнено" label in the bag UI
    if not full then
        local root = chain(pg, "MainGUI", "Game", "CoinBags") or chain(pg, "MainGUI", "Lobby", "Dock", "CoinBags")
        if root then
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible and (d.Text:find("Full") or d.Text:find("FULL") or d.Text:find("Заполнен") or d.Text:find("заполнен")) then
                    full = true
                    break
                end
            end
        end
    end
    bagCache = full
    return full
end

local container
local lastScan = 0
local function findContainer()
    if container and container.Parent and container:IsDescendantOf(workspace) then return container end
    if container then
        container = nil
        totals.rounds += 1
        session.rounds = (session.rounds or 0) + 1
    end
    if os.clock() - lastScan < 1 then return nil end
    lastScan = os.clock()
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst.Name == "CoinContainer" then
            container = inst
            return inst
        end
    end
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local roleRemote
local murdererPlayer
local function refreshRoles()
    if not (roleRemote and roleRemote.Parent) then
        roleRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    end
    if not roleRemote then return end
    local ok, data = pcall(function() return roleRemote:InvokeServer() end)
    if ok and type(data) == "table" then
        murdererPlayer = nil
        for name, info in pairs(data) do
            if type(info) == "table" and info.Role == "Murderer" and not info.Dead then
                murdererPlayer = Players:FindFirstChild(tostring(name))
            end
        end
    end
end
task.spawn(function()
    while alive do
        if cfg.farm and (cfg.avoid or cfg.fullAction == "Fling murderer") then pcall(refreshRoles) end
        task.wait(2)
    end
end)

local ignored = setmetatable({}, {__mode = "k"})
local murdererPos, lastMurd = nil, 0
local function updateMurderer()
    if os.clock() - lastMurd < 0.3 then return end
    lastMurd = os.clock()
    murdererPos = nil
    if not cfg.avoid then return end
    local mp = murdererPlayer
    local mroot = mp and mp ~= LP and mp.Character and mp.Character:FindFirstChild("HumanoidRootPart")
    if mroot then
        murdererPos = mroot.Position
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local bp = p:FindFirstChild("Backpack")
            if root and (p.Character:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))) then
                murdererPos = root.Position
                return
            end
        end
    end
end
local function isCoin(obj)
    if not obj:IsA("BasePart") or ignored[obj] then return false end
    if obj.Name == "Coin_Server" then return true end
    return obj:FindFirstChildWhichIsA("TouchTransmitter") ~= nil
end
local function pickCoin(origin)
    local cont = findContainer()
    if not cont then return nil end
    updateMurderer()
    local best, bestD = nil, cfg.maxDist
    for _, obj in ipairs(cont:GetChildren()) do
        if isCoin(obj) then
            local d = (origin - obj.Position).Magnitude
            if d < bestD and not (murdererPos and (murdererPos - obj.Position).Magnitude < 24) then
                best, bestD = obj, d
            end
        end
    end
    return best
end

-- ───────── bag counters → stats ─────────
local bagLast = {}
local function pollBags()
    local box = chain(LP:FindFirstChild("PlayerGui"), "MainGUI", "Game", "CoinBags", "Container")
    if not box then return end
    for _, bag in ipairs(box:GetChildren()) do
        local label = bag:FindFirstChild("Coins", true)
        if label and label:IsA("TextLabel") then
            local v = tonumber((label.Text:gsub("[^%d]", ""))) or 0
            local last = bagLast[bag.Name] or v
            if v > last then
                local d = v - last
                session.coins += d
                totals.coins += d
                session.bags[bag.Name] = (session.bags[bag.Name] or 0) + d
                totals.bags[bag.Name] = (totals.bags[bag.Name] or 0) + d
            end
            bagLast[bag.Name] = v
        end
    end
end

-- ───────── movement ─────────
local noclipParts, noclipChar = {}, nil
local function rebuildParts(ch)
    noclipChar = ch
    noclipParts = {}
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("BasePart") then noclipParts[#noclipParts + 1] = d end
    end
end
local flying = false
local lastRebuild = 0
bind(RunService.Stepped, function()
    if flying and LP.Character then
        if noclipChar ~= LP.Character or os.clock() - lastRebuild > 1.5 then
            lastRebuild = os.clock()
            rebuildParts(LP.Character)
        end
        for i = 1, #noclipParts do
            local p = noclipParts[i]
            if p.CanCollide then p.CanCollide = false end
        end
    end
end)
local function prep(hum)
    flying = true
    if not hum.PlatformStand then hum.PlatformStand = true end
    local root = hum.RootPart
    if root and root.Anchored then root.Anchored = false end
end
local function release()
    if not flying then return end
    flying = false
    local ch, hum = getChar()
    if hum then hum.PlatformStand = false end
end
local function touch(hrp, coin)
    if firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, coin, 0)
            firetouchinterest(hrp, coin, 1)
        end)
    end
end
local ROT = CFrame.Angles(-math.pi / 2, 0, 0)
local touchedAt = setmetatable({}, {__mode = "k"})
local function touchNear(hrp)
    local cont = container
    if not cont or not cont.Parent then return end
    local now, r = os.clock(), cfg.touchRadius
    local pos = hrp.Position
    for _, o in ipairs(cont:GetChildren()) do
        if o:IsA("BasePart") and (pos - o.Position).Magnitude <= r and (not touchedAt[o] or now - touchedAt[o] > 0.35) and isCoin(o) then
            touchedAt[o] = now
            touch(hrp, o)
        end
    end
end
local function findMurderer(fresh)
    if fresh then pcall(refreshRoles) end
    if murdererPlayer and murdererPlayer ~= LP and murdererPlayer.Parent and murdererPlayer.Character then return murdererPlayer end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local bp = p:FindFirstChild("Backpack")
            if p.Character:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return p end
        end
    end
end
local function flingMurderer(force)
    local p = findMurderer(true)
    local ch, hum, hrp = getChar()
    if not (p and ch) then return false end
    local tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot then return false end
    local home = hrp.CFrame
    local startPos = tRoot.Position
    flying = false
    hum.PlatformStand = true
    local t0 = os.clock()
    while alive and (cfg.farm or force) and os.clock() - t0 < 3.5 do
        local c2, h2, r2 = getChar()
        tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if not (c2 and tRoot) then break end
        if (tRoot.Position - startPos).Magnitude > 140 or tRoot.Position.Y < -200 then break end
        r2.CanCollide = true
        r2.CFrame = tRoot.CFrame * CFrame.new((math.random() - 0.5) * 1.2, 0, (math.random() - 0.5) * 1.2)
        r2.AssemblyAngularVelocity = Vector3.new(0, 3e4, 0)
        r2.AssemblyLinearVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end
    local c3, h3, r3 = getChar()
    if r3 then
        r3.AssemblyAngularVelocity = Vector3.zero
        r3.AssemblyLinearVelocity = Vector3.zero
        r3.CFrame = home
        h3.PlatformStand = false
    end
    return true
end
local jitter, nextJitter = 1, 0
local function collect(coin, hum, hrp)
    prep(hum)
    local started = os.clock()
    local touched = false
    local checkPos, checkAt = hrp.Position, os.clock()
    while alive and cfg.farm and coin.Parent and hrp.Parent and os.clock() - started < 7 do
        if os.clock() - checkAt > 1.5 then
            if (hrp.Position - checkPos).Magnitude < 0.5 then
                -- stuck: snap straight onto the coin once, otherwise give up on it
                hrp.CFrame = CFrame.new(coin.Position - Vector3.new(0, cfg.offset, 0)) * ROT
                touch(hrp, coin)
                ignored[coin] = true
                task.delay(20, function() ignored[coin] = nil end)
                return "stuck"
            end
            checkPos, checkAt = hrp.Position, os.clock()
        end
        local target = coin.Position - Vector3.new(0, cfg.offset, 0)
        local diff = target - hrp.Position
        local dist = diff.Magnitude
        local dt
        if cfg.method == "Hop" then
            local step = math.min(dist, cfg.hopDist)
            hrp.CFrame = CFrame.new(hrp.Position + (dist > 0 and diff.Unit * step or Vector3.zero)) * ROT
            hrp.AssemblyLinearVelocity = Vector3.zero
            touchNear(hrp)
            if dist - step < cfg.touchRadius then touch(hrp, coin) end
            touched = dist <= cfg.hopDist
            task.wait(cfg.hopDelay * (cfg.humanize and (0.8 + math.random() * 0.5) or 1))
        else
            dt = RunService.Heartbeat:Wait()
            if cfg.humanize and os.clock() > nextJitter then
                jitter = 0.85 + math.random() * 0.3
                nextJitter = os.clock() + 0.4
                if math.random() < 0.03 then task.wait(0.12 + math.random() * 0.25) end
            end
            local step = cfg.speed * (cfg.humanize and jitter or 1) * dt
            if dist <= step then
                hrp.CFrame = CFrame.new(target) * ROT
                touched = true
            else
                hrp.CFrame = CFrame.new(hrp.Position + diff.Unit * step) * ROT
            end
            hrp.AssemblyLinearVelocity = Vector3.zero
            touchNear(hrp)
            if dist < cfg.touchRadius or touched then touch(hrp, coin) end
        end
        if touched then break end
        if not getChar() then return end
    end
    if touched then
        ignored[coin] = true
        task.delay(2, function() ignored[coin] = nil end)
    else
        ignored[coin] = true
        task.delay(5, function() ignored[coin] = nil end)
    end
end

local stuckCount = 0
task.spawn(function()
    while alive do
        if not cfg.farm then
            release()
            setStatus("Idle", GREY)
            task.wait(0.3)
        else
            local ch, hum, hrp = getChar()
            if not ch then
                release()
                setStatus("Respawning", AMBER)
                task.wait(0.4)
            elseif bagFull() then
                release()
                local act = cfg.fullAction
                if act == "Fling murderer" then
                    setStatus("Bag full → fling murderer", AMBER)
                    local okF, flung = pcall(flingMurderer)
                    if not (okF and flung) then setStatus("No murderer found → waiting", AMBER) task.wait(1) end
                    setStatus("Waiting for round end", AMBER)
                    local t0 = os.clock()
                    while alive and cfg.farm and findContainer() and bagFull() and os.clock() - t0 < 25 do
                        task.wait(0.5)
                    end
                    local c4, h4 = getChar()
                    if h4 and findContainer() and bagFull() then
                        setStatus("Bag full → reset", AMBER)
                        h4.Health = 0
                        task.wait(4)
                    end
                elseif act == "Reset" then
                    setStatus("Bag full → reset", AMBER)
                    hum.Health = 0
                    task.wait(4)
                else
                    setStatus("Bag full", AMBER)
                    task.wait(1)
                end
            elseif not findContainer() then
                release()
                setStatus("Waiting for round", GREY)
                task.wait(0.5)
            else
                local coin = pickCoin(hrp.Position)
                if not coin then
                    setStatus("Searching coins", GREY)
                    task.wait(0.15)
                else
                    setStatus("Farming", GREEN)
                    local okc, res = pcall(collect, coin, hum, hrp)
                    if okc and res == "stuck" then
                        stuckCount += 1
                        if stuckCount >= 3 then
                            stuckCount = 0
                            setStatus("Stuck → reset", AMBER)
                            release()
                            hum.Health = 0
                            task.wait(4)
                        end
                    else
                        stuckCount = 0
                    end
                end
            end
        end
    end
end)


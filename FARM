local whText = text(whInfo, "Every N minutes (default 10) an embed with: status, session coins and the gain since the last report, per-hour rate, projected per day, coin/candy split, runtime, rounds, all-time total, kicks/rejoins, players in server and the farm method.\n\nA red message is also sent when you get kicked, before the rejoin starts.\n\nThe webhook URL is saved only on this PC in FlinFarm/data.json.", 13, C.sub, UDim2.fromOffset(14, 34), UDim2.new(1, -28, 1, -44))

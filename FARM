local LOGO_B64 = ""

local function b64(data)
    for _, fn in ipairs({crypt and crypt.base64decode, crypt and crypt.base64 and crypt.base64.decode, base64_decode, base64 and (base64.decode or base64.Decode)}) do
        local ok, res = pcall(fn, data)
        if ok and type(res) == "string" and #res > 100 then return res end
    end
    local al = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, 64 do map[al:sub(i, i)] = i - 1 end
    local out, buf, bits = {}, 0, 0
    for ch in data:gmatch("[%w%+/]") do
        buf = buf * 64 + map[ch]
        bits += 6
        if bits >= 8 then
            bits -= 8
            local byte = math.floor(buf / 2 ^ bits)
            buf -= byte * 2 ^ bits
            out[#out + 1] = string.char(byte)
        end
    end
    return table.concat(out)
end

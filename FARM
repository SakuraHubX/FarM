-- ───────── kick / disconnect → rejoin ─────────
local rejoining = false
local queued = false
local function rejoinReady()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    local url = SCRIPT_URL ~= "" and SCRIPT_URL or tostring(cfg.url or "")
    return q ~= nil and (url ~= "" or (isfile ~= nil and isfile("FlinFarm.lua")))
end
-- queue the relaunch ONCE per run (so retries never stack copies); re-called after the URL changes
local function queueReload(force)
    if queued and not force then return true end
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if not q then return false end
    local url = SCRIPT_URL ~= "" and SCRIPT_URL or tostring(cfg.url or "")
    local code
    if url ~= "" then
        code = 'repeat task.wait() until game:IsLoaded() task.wait(1) local ok, err = pcall(function() loadstring(game:HttpGet("' .. url .. '"))() end) if not ok then warn("[FlinFarm] relaunch failed: " .. tostring(err)) end'
    elseif isfile and isfile("FlinFarm.lua") then
        code = 'repeat task.wait() until game:IsLoaded() task.wait(1) loadstring(readfile("FlinFarm.lua"))()'
    end
    if not code then return false end
    local ok = pcall(q, code)
    queued = ok
    return ok
end
local hopping = false
local function serverHop(reason)
    if hopping or rejoining then return end
    hopping = true
    setStatus("Low players → server hop", AMBER)
    totals.lastReason = tostring(reason):sub(1, 60)
    totals.rejoins += 1
    save(true)
    queueReload()
    task.spawn(function()
        local target
        pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
            local data = HttpService:JSONDecode(game:HttpGet(url))
            local pool = {}
            for _, s in ipairs(data.data or {}) do
                if s.id ~= game.JobId and s.playing and s.maxPlayers
                    and s.playing >= math.max(cfg.minPlayers + 2, 6) and s.playing < s.maxPlayers - 1 then
                    pool[#pool + 1] = s.id
                end
            end
            if #pool > 0 then target = pool[math.random(1, math.min(#pool, 10))] end
        end)
        for attempt = 1, 4 do
            if not alive then return end
            if target then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, target, LP) end)
            else
                pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
            end
            task.wait(12)
        end
        hopping = false
    end)
end
task.spawn(function()
    local low, since = 0, os.clock()
    while alive do
        task.wait(3)
        if cfg.farm and cfg.minPlayers > 0 and not hopping and not rejoining and os.clock() - since > 15 then
            if #Players:GetPlayers() < cfg.minPlayers then
                low += 1
                if low >= 3 then
                    low = 0
                    serverHop("players < " .. cfg.minPlayers)
                end
            else
                low = 0
            end
        end
    end
end)
local function rejoin(reason)
    if rejoining or not cfg.autoRejoin then return end
    rejoining = true
    totals.kicks += 1
    totals.rejoins += 1
    totals.lastReason = tostring(reason or "disconnected"):sub(1, 60)
    if cfg.adaptive and status == "Farming" and cfg.farm then
        local old = cfg.speed
        cfg.speed = math.max(10, math.floor(cfg.speed * 0.75))
        totals.lastReason = totals.lastReason .. " (speed " .. old .. "→" .. cfg.speed .. ")"
    end
    save(true)
    setStatus("Rejoining…", AMBER)
    task.spawn(function()
        local attempt = 0
        while alive do
            attempt += 1
            queueReload()
            pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
            task.wait(math.min(8 * attempt, 40))
        end
    end)
end
pcall(function()
    local overlay = CoreGui:WaitForChild("RobloxPromptGui", 10):WaitForChild("promptOverlay", 10)
    bind(overlay.ChildAdded, function(child)
        if child.Name == "ErrorPrompt" then
            task.wait(0.4)
            local msg = "kicked"
            pcall(function() msg = child.MessageArea.ErrorFrame.ErrorMessage.Text end)
            rejoin(msg)
        end
    end)
end)
pcall(function()
    bind(GuiService.ErrorMessageChanged, function(msg)
        if msg and msg ~= "" then rejoin(msg) end
    end)
end)
queueReload()
if not rejoinReady() then warn("[FlinFarm] auto-restart after rejoin is NOT ready: set Script URL in the Safety tab") end

-- ───────── auto "Play" after (re)join ─────────
local function isShown(obj)
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end
local function isPlayText(s)
    s = tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
    return s == "Играть" or s == "ИГРАТЬ" or s:lower() == "play"
end
local function pressButton(btn)
    local used = false
    if firesignal then
        for _, ev in ipairs({"MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated"}) do
            if pcall(firesignal, btn[ev]) then used = true end
        end
    end
    if getconnections then
        for _, ev in ipairs({"MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated"}) do
            pcall(function()
                for _, c in ipairs(getconnections(btn[ev])) do
                    pcall(function() c:Fire() end)
                    used = true
                end
            end)
        end
    end
